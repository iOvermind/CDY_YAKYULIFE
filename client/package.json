    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
